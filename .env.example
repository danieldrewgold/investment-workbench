# Copy to .env and fill in. .env is gitignored; nothing in this repo reads keys from source.
# Only ANTHROPIC_API_KEY is strictly required — every other source degrades gracefully when unset.

# --- Required: research brief, transcript digests, claim verification, deck vision ---
ANTHROPIC_API_KEY=

# --- Market data (financials, quarterly history) ---
POLYGON_API_KEY=            # primary financials; free tier works but rate-limits (~5 req/min)
ALPHA_VANTAGE_API_KEY=      # cost-detail fallback (free key: alphavantage.co)

# --- SEC EDGAR: requires a real contact in the User-Agent or it may throttle you ---
SEC_USER_AGENT=YourName research you@example.com

# --- Optional macro / credit context ---
BLS_API_KEY=                # api.bls.gov (higher rate limit with a key)
BEA_API_KEY=                # apps.bea.gov
FINRA_DATA_CLIENT_ID=       # FINRA TRACE bond data (OAuth client credentials)
FINRA_DATA_CLIENT_SECRET=

# --- Optional: earnings-call transcripts (paid; EarningsCall.biz). Without it the
#     transcript step falls back to Yahoo for seeded names and otherwise runs empty. ---
ECALL_API_KEY=

# --- Tuning (optional) ---
# AUDIT_MODEL=claude-sonnet-4-6       # model for the adversarial audit pass
# DECK_ANALYSIS_ENABLED=1             # 0 disables investor-deck vision analysis (saves API cost)
# INSIDER_NETWORTH=1                  # 0 disables the cross-company insider net-worth crawl
